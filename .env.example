# ===== .env 示例模板（复制为 .env 后填入真实值，.env 已被 gitignore）=====
# 放置位置：项目根目录下的 .env（与 config.yaml 同级）
# 优先级：启动时的 shell 环境变量 > 本文件(.env) > config.yaml
# 说明：以下变量名与 src/llm/client.py 读取的 os.environ 完全一致

# 主服务商密钥（对应 config.yaml llm.api_key / llm.base_url）
# 例：kenari.id 的 key
LLM_API_KEY=your_kenari_api_key_here

# 备用服务商密钥（对应 config.yaml llm.fallback_api_key / llm.fallback_base_url）
# 例：NVIDIA 的 key
LLM_FALLBACK_API_KEY=your_nvidia_api_key_here

# （可选）如需覆盖 config.yaml 里的 base_url / 模型，也可在此指定
# LLM_BASE_URL=https://kenari.id/v1
# LLM_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_FALLBACK_MODEL=deepseek-ai/deepseek-v4-flash

# 二级备用服务商（对应 config.yaml llm.secondary_fallback_*）
# 主 + 备用都不可用时启用的第三档兜底，不配则该档自动跳过。
# LLM_SECONDARY_FALLBACK_API_KEY=your_secondary_fallback_key_here
# LLM_SECONDARY_FALLBACK_BASE_URL=https://your-secondary-provider/v1
# LLM_SECONDARY_FALLBACK_MODEL=your_secondary_model

# （可选）Embedding 独立密钥；留空则回退使用 LLM_API_KEY
# EMBEDDING_API_KEY=your_embedding_key_here

# （可选）HuggingFace token；BGE 向量模型首次联网拉取权重时使用，
# 模型已在本地缓存时可留空（对应 config.yaml embedding.hf_token）。
# HF_TOKEN=your_huggingface_token_here
