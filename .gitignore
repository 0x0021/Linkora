# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
# 前端构建产物（esbuild 合并后的单 bundle）需入库，供 Docker COPY 与静态服务直接取用
!web/static/dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
.venv/
venv/
ENV/
env/

# Secrets (env files with credentials — keep local only)
.env
.env.*
!.env.example

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Project specific
config.yaml
config.local.yaml
data/
logs/
*.log
*.pid
*.db
*.db-shm
*.db-wal
# Config backups (contain plaintext keys, never commit!)
data/config-backups/
data/config-daily-backups/

# Test files (仅忽略根目录临时测试，不忽略 tests/ 下的正式测试)
/test_*.py
*_test.py
pytest.ini
.coverage

# Documentation (if generated)
docs/_build/
*.md.bak

# 配置文件备份（含明文密钥，禁止入库！）
config.yaml
config.yaml.bak*
config.yaml.damaged*
*.bak
*.secret
*.env

# dws 凭证目录（宿主绑定 ./dingtalk，含登录态，禁止入库！）
dingtalk/

# Workbuddy (if used)
.workbuddy/

# Node (if web uses npm)
node_modules/
# package-lock.json 必须入库：CI frontend job 用 npm ci，依赖 lock 文件可复现构建
npm-debug.log

# pytest-cov residual
.coverage 2
.coverage 3

# ---- 开源加固：凭据 / 证书 / OS 垃圾 / 缓存（防御性，防止将来误提交）----
# 私钥 / TLS 证书
*.key
*.pem
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_ed25519
id_dsa
id_ecdsa
# 本地数据库衍生
*.sqlite
*.sqlite3
*.dump
# OS / 编辑器垃圾
Thumbs.db
ehthumbs.db
Desktop.ini
# Python 缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Agent 本地记录（非项目产物）
.agnes/
