# ============================================================
# 灵桥 (Linkora) — 企业 AI 智能连接平台 · 配置文件示例
# ============================================================
#
# 使用方法：
#   1. 复制本文件为 config.yaml：cp config.yaml.example config.yaml
#   2. 修改以下配置项（带 * 为必填项；涉及密钥/密码的请务必修改）
#   3. 启动程序：python main.py --web 8080
#   4. 修改配置后无需重启，程序会自动热重载（Hot Reload）
#
# 配置结构总览：
#   ★ platforms  —— 多平台隔离主配置段（每个 IM 平台独立适配器/数据库/轮询器），运行期以本段为准
#   ① dws / ② embedding / ③ llm / ③b llm_throttle / ④ logging / ⑤ memory
#   ⑥ poller(legacy) / ⑦ rules / ⑧ safety / ⑨ rag / ⑩ skills / ⑪ dead_letter / ⑫ web / ⑬ tools / ⑭ storage(legacy)
#   说明：legacy 段（dws / poller / storage）由 config_manage 工具读取状态，请与 platforms 中对应平台保持一致。

# ============================================================
# ★ 多平台隔离配置（platforms）—— 主配置段
#  - 每个 IM 平台一个独立配置：独立适配器 / 独立数据库(./data/<id>-ai.db) / 独立轮询器。
#  - 运行期以本段为准；新增飞书/企微时在列表内追加对应条目
#    （adapter_type: feishu / wecom，并配置 adapter.cli_path 为 lark-cli / wecom-cli）。
#  - 下方 ① dws / ⑥ poller / ⑭ storage 为 legacy 兼容段（config_manage 读取），
#    值与本段 dingtalk 平台保持一致即可。
# ============================================================
platforms:
  - id: dingtalk
    display_name: 钉钉
    enabled: true
    adapter_type: dingtalk
    storage:
      type: sqlite                                   # 数据库类型（当前仅支持 sqlite）
      path: ./data/linkora.db                    # 数据库文件路径（按平台隔离，勿与 legacy 段混淆）
      backup_enabled: true                           # 是否启用自动备份
      backup_dir: ./data/backups                     # 备份文件目录
      backup_interval_hours: 24                      # 备份间隔（小时），24 = 每天一次
      backup_max_count: 7                            # 保留最近多少份备份
      backup_on_start: true                          # 启动时立即备份一次
      decisions_retention_days: 14                   # 决策追踪表留存天数（≤0 表示不按时间清理）
      messages_retention_days: 90                    # 消息记录留存天数（≤0 表示不清理）
      doc_sync_interval_hours: 1                     # 钉钉文档自动同步间隔（小时），≤0 禁用
    poller:
      # —— 基础轮询 ——
      interval_seconds: 10                           # 轮询间隔（秒）
      unread_conversation_count: 50                  # 单轮拉取的未读会话数上限
      messages_per_conversation: 16                  # 每个会话单次拉取的最大消息数
      merge_window_seconds: 5                        # 同会话多条消息在此时间内合并处理
      history_window: 12                             # 带入 LLM 上下文的历史消息条数（= max_recent + 2，原料窗需 > 近期条数才能触发 H2-A 异步摘要；feishu/wecom 同为 12）
      history_days: 3                                # 历史消息取最近 N 天
      history_session_gap_minutes: 360               # 会话切分间隔：相邻历史消息间隔超此值视为新对话轮次（0=禁用切分）
      max_processed_msg_ids: 500                     # 跨轮次去重内存缓存上限（LRU）
      first_run_ignore_older_than_minutes: 5         # 首次运行/重启后忽略超过 N 分钟的老消息（0=不忽略）
      reply_cooldown_seconds: 10                     # 同一会话回复冷却时间（秒），防止短时间反复回复
      owner_present_cooldown_seconds: 600            # 真人在场冷却（秒）：窗口内真人活跃则 AI 不插嘴，离场超时后接管
      suppress_when_owner_read: true                 # 已读闸门：DWS 判定会话已读(无未读)则 AI 不回；新未读消息仍照常回。失真漏回时设 false
      mark_read_after_process: true                  # 处理完后将该会话消息标记为已读
      # —— 背压 / 并发 ——
      max_dispatch_per_cycle: 30                     # 单轮最多派发给 handler 的消息数（0=不限制）
      max_concurrent_replies: 4                      # 同时进行的回复（LLM 调用）上限
      reply_concurrency_timeout_seconds: 30         # 等待并发槽位超时（秒）；超时降级串行，不丢消息
      # —— list-all 主通道 ——
      list_all_time_window_minutes: 30               # list-all 时间窗口（分钟）
      list_all_first_run_minutes: 5                  # list-all 首次运行时间窗口（分钟）
      list_all_full_scan_interval_minutes: 60        # 飞书全量扫描间隔（分钟）：每隔这么久做一次完整 +chat-list 翻页发现新会话；0=永不自动全量扫描
      list_all_empty_alert_rounds: 6                 # 连续 N 轮 list-all 零新消息则告警（0=关闭）
      empty_poll_protection_minutes: 5               # 空转保护间隔（分钟）
      # —— list-all 分页与窗口保护（防止宽时间窗每轮重扫全部历史、永远撞分页上限）——
      list_all_max_pages: 50                         # list-all 单轮分页硬上限（每页 limit 条，默认 100）；0=不限制。原硬编码 20 在活跃群易触顶漏消息
      list_all_max_window_days: 14                   # list-all 实时轮询扫描窗口上限（天）：把误配的 22 天等超宽窗钳制到最近 N 天。深度回填请走 sync_history
      # —— 跳过策略 ——
      skip_msg_types:                                # 直接跳过的消息类型（不处理）
        - system
        - app
        - file
        - call
        - voice
        - video
        - read_receipt                           # 已读回执类系统通知（[已读]/已读回执/英文 read receipt 等）
      graceful_fallback_msg_types: []                # 优雅回退类型：当前 voice/video 已并入 skip_msg_types 彻底静默跳过，故留空
      # 通知抑制（结构优先 + 窄签名）：
      # 绝大多数通知已由 msgType（skip_msg_types）+ 系统/机器人发送者（系统账号名单）结构层静默拦截。
      # 本字段仅作「以真人身份推送的纯文本机器通知」的安全网：
      #   - 只写【机器生成物】的窄正则（固定模板/报错栈），绝不写宽泛裸词，以免误伤真人消息。
      #   - 默认空=不静默，交给 LLM 处理（如 U9C 报错由 AI 提炼要点）。
      #   - 例：r"^\d{4}-\d{2}-\d{2}\d+发货通知单[：:]" 可精确命中某 ERP 推送。
      skip_notification_patterns: []
      # 按发送者 ID 精确静默机器人/三方应用账号（结构性静音，强于按名匹配）
      skip_notification_sender_ids: []
      # —— 图片 OCR ——
      image_ocr_enabled: true                       # 启用后下载截图并 OCR，让 LLM 能"看懂"图片
      image_temp_dir: ./data/tmp_images             # OCR 临时下载目录（处理完即删）
      # —— 多组织 / 跨组织 ——
      target_org_corp_id: ''                        # 多组织环境下仅轮询该组织；留空=当前登录 profile 所属组织
      # —— 会话黑名单容错 ——
      blacklist_min_consecutive_failures: 3         # 群聊权限错误需连续失败达此次数才拉黑（0=立即拉黑）
      blacklist_reconcile_every: 10                 # 黑名单自愈对账间隔（轮数）
      reconcile_probe_batch_size: 5                 # 自愈每轮直接探测上限（轮转分批）
      # —— 缓存 / 限频 ——
      top_convs_cache_ttl_seconds: 120              # 置顶/最近会话列表缓存 TTL（秒）
      min_conversation_poll_interval_seconds: 60    # 长尾会话最小抓取间隔（秒）；未读会话不受影响
      # —— 合规透明 ——
      ai_tag_enabled: true                          # 发送时携带"由AI发送"标签（合规透明）；false=与本人手发无区别
    adapter:                                         # 钉钉 → DwsConfig 字段
      cli_path: dws                                  # DWS CLI 可执行文件路径（默认 "dws" 表示使用 PATH 中的命令）
      dry_run: false                                # true = 只模拟，不真正发送消息
      profile: ''                                   # DWS 登录 profile（多账号场景；默认空=默认账号）
      retries: 2                                    # DWS 命令重试次数
      timeout: 30                                   # DWS 命令超时（秒）
  # ── 飞书 / 企业微信：可选平台，默认关闭 ──
  # 启用步骤：① 安装对应 CLI（lark-cli / wecom-cli）；② 取消下方注释；③ 把 enabled 改为 true。
  # poller / storage / adapter 字段含义与上方 dingtalk 完全一致（钉钉段已逐行注释）。
  # - id: feishu
  #   display_name: 飞书
  #   enabled: false
  #   adapter_type: feishu
  #   storage:
  #     type: sqlite
  #     path: ./data/feishu-ai.db
  #     backup_enabled: true
