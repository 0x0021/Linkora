{
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  },
  "scripts": {
    "test:frontend": "vitest run",
    "test:frontend:watch": "vitest",
    "build:frontend": "node scripts/build_frontend.mjs",
    "build:frontend:watch": "node scripts/build_frontend.mjs --watch",
    "smoke:bundle": "node scripts/smoke_bundle.mjs",
    "smoke:runtime": "node scripts/smoke_runtime.mjs",
    "lint": "eslint web/static/js --ext .js",
    "lint:fix": "eslint web/static/js --ext .js --fix",
    "format": "prettier --write \"web/static/js/**/*.js\"",
    "verify:frontend": "npm run build:frontend && npm run lint && npm run smoke:bundle && npm run smoke:runtime && npm run test:frontend"
  }
}
